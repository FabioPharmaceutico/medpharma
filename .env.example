# === Desenvolvimento local (SQLite — sem Docker) ===
# Padrão: um arquivo local, zero instalação de banco.
DATABASE_URL="file:./dev.db"

# === Produção (PostgreSQL) — opcional ===
# Para produção, use prisma/schema.postgres.prisma e uma URL Postgres, ex.:
# DATABASE_URL="postgresql://user:senha@host:5432/medapp?schema=public"
